DZ_HOST=127.0.0.1
DZ_PORT=5000
DZ_SECRET_KEY=replace-with-a-long-random-secret
DZ_ADMIN_USERNAME=admin
# Recommended: generate a hash with `python make_password.py` and paste it here.
# If omitted on first run, DZ_Shutdown generates a random one-time admin password and prints it to the console.
DZ_ADMIN_PASSWORD_HASH=
DZ_COOKIE_SECURE=0
DZ_SCREEN_FPS=8
DZ_SCREEN_SCALE=0.65
DZ_COMMAND_TIMEOUT=12
DZ_SESSION_MINUTES=120

# Anti brute-force defaults
DZ_LOGIN_REQUEST_LIMIT=30
DZ_LOGIN_REQUEST_WINDOW=300
DZ_LOGIN_MAX_FAILURES=5
DZ_LOGIN_FAILURE_WINDOW=600
DZ_LOGIN_BASE_LOCK=30
DZ_LOGIN_MAX_LOCK=900
